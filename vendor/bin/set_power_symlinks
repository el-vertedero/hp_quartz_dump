# Configures the correct XML variant for Media Profile,
# based on the existence of model-based or SKU-based media profile XML.
# The correct XML variant is stored in a temporary property key because
# scripts has no permission to modify ro.* properties.

# A script to choose proper PnP configuration files for the device model
# and optionally SKU.

TARGET=${1:-/dev/power/irq-by-name}

# Intel XE driver
XE_IRQ=$(dirname /proc/irq/*/xe)
if [ -d "${XE_IRQ}" ]; then
    ln -s ${XE_IRQ} $TARGET/xe
fi
