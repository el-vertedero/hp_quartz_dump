on boot
    start adbd_killer_init

service adbd_killer_init /vendor/bin/init.adbd-killer.sh
    class main
    user root
    group root ap_firmware system
    disabled
    oneshot

# Allow ADB to run "unsafely".
# Note that SSH-to-ADB forwarder is also started in unsafe mode, but uses its
# own trigger block to avoid mutual dependency on adbd-killer.
on property:ro.vendor.adbd.unsafe=1
    setprop ro.vendor.adbd.killer.called 1

    # Restore listen_addrs default settings, re-enabling ADB external access
    setprop service.adb.listen_addrs ""
    stop adbd
    start adbd
