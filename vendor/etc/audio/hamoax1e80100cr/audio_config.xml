    <SoundCardName>hamoax1e80100cr</SoundCardName>
    <HiFi>
        <Speaker>
            <PlaybackPCM><!-- UNUSED --></PlaybackPCM>
        </Speaker>
        <SpeakerSafe>
            <PlaybackPCM><!-- UNUSED --></PlaybackPCM>
        </SpeakerSafe>
        <!-- Omit Headphone if the device does not have 3.5mm jack -->
        <Headphone>
            <PlaybackPCM><!-- UNUSED --></PlaybackPCM>
            <PlaybackMixerElem><!-- UNUSED --></PlaybackMixerElem>
            <JackDev><!-- UNUSED --></JackDev>
            <JackSwitch>0<!-- UNUSED --></JackSwitch>
        </Headphone>
        <InternalMic>
            <CapturePCM><!-- UNUSED --></CapturePCM>
            <CaptureChannelMap><!-- UNSUPORRTED --></CaptureChannelMap>

            <!-- DO NOT CHANGE, Please use ACDB tuning -->
            <IntrinsicSensitivity>0</IntrinsicSensitivity>
        </InternalMic>
        <!-- Omit Mic if the device does not have 3.5mm jack -->
        <Mic>
            <CapturePCM><!-- UNUSED --></CapturePCM>
            <CaptureMixerElem><!-- UNUSED --></CaptureMixerElem>
            <JackDev><!-- UNUSED --></JackDev>
        </Mic>
        <HDMI1>
            <PlaybackPCM><!-- UNUSED --></PlaybackPCM>
            <JackDev><!-- UNUSED --></JackDev>
        </HDMI1>
        <FrontMic>
            <CapturePCM><!-- UNUSED --></CapturePCM>
            <CaptureChannelMap><!-- UNSUPORRTED --></CaptureChannelMap>

            <!-- DO NOT CHANGE, Please use ACDB tuning -->
            <IntrinsicSensitivity>0</IntrinsicSensitivity>
        </FrontMic>
        <RearMic>
            <CapturePCM><!-- UNUSED --></CapturePCM>
            <CaptureChannelMap><!-- UNSUPORRTED --></CaptureChannelMap>

            <!-- DO NOT CHANGE, Please use ACDB tuning -->
            <IntrinsicSensitivity>0</IntrinsicSensitivity>
        </RearMic>
        <SCOLineOut>
            <PlaybackPCM><!-- UNUSED --></PlaybackPCM>
        </SCOLineOut>
        <SCOLineIn>
            <CapturePCM><!-- UNUSED --></CapturePCM>
        </SCOLineIn>
    </HiFi>
</audio_config>
