	<SoundCardName>hw:Adapter</SoundCardName>
	<HiFi>
		<USBOut>
			<Section>
				<SectionName>USB-C Headphone</SectionName>
				<PlaybackPCM>hw:Adapter,0</PlaybackPCM>
				<PlaybackRate>48000</PlaybackRate>
				<UseSoftwareVolume>1</UseSoftwareVolume>
			</Section>
		</USBOut>
		<USBIn>
			<Section>
				<SectionName>USB-C Mic</SectionName>
				<CapturePCM>hw:Adapter,0</CapturePCM>
				<IntrinsicSensitivity>-2600</IntrinsicSensitivity>
			</Section>
		</USBIn>
	</HiFi>
</audio_config>