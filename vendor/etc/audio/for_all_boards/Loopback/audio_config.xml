	<SoundCardName>hw:Loopback</SoundCardName>
	<HiFi>
		<USBOut>
			<Section>
				<SectionName>Loopback Playback</SectionName>
				<PlaybackPCM>hw:Loopback,0</PlaybackPCM>
				<PlaybackChannels>8</PlaybackChannels>
			</Section>
		</USBOut>
		<USBIn>
			<Section>
				<SectionName>Loopback Capture</SectionName>
				<CapturePCM>hw:Loopback,1</CapturePCM>
				<CaptureChannels>8</CaptureChannels>
			</Section>
		</USBIn>
	</HiFi>
</audio_config>