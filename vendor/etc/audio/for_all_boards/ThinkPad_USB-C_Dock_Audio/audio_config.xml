	<SoundCardName>hw:Audio</SoundCardName>
	<HiFi>
		<USBOut>
			<Section>
				<SectionName>ThinkPad USB-C Dock Audio: Output</SectionName>
				<PlaybackPCM>hw:Audio,0</PlaybackPCM>
				<UseSoftwareVolume>1</UseSoftwareVolume>
			</Section>
		</USBOut>
		<USBIn>
			<Section>
				<SectionName>ThinkPad USB-C Dock Audio: Input</SectionName>
				<CapturePCM>hw:Audio,0</CapturePCM>
			</Section>
		</USBIn>
	</HiFi>
</audio_config>