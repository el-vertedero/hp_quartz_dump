	<SoundCardName>hw:Wireless</SoundCardName>
	<HiFi>
		<USBOut>
			<Section>
				<SectionName>Arctis Pro Wireless Bluetooth</SectionName>
				<PlaybackPCM>hw:Wireless,0</PlaybackPCM>
				<PlaybackMixerElem>PCM,0</PlaybackMixerElem>
			</Section>
			<Section>
				<SectionName>Arctis Pro Wireless Lineout</SectionName>
				<PlaybackPCM>hw:Wireless,1</PlaybackPCM>
				<PlaybackMixerElem>PCM,1</PlaybackMixerElem>
			</Section>
		</USBOut>
		<USBIn>
			<Section>
				<SectionName>Arctis Pro Wireless Input</SectionName>
				<CapturePCM>hw:Wireless,0</CapturePCM>
			</Section>
		</USBIn>
	</HiFi>
</audio_config>