     Documentation at frameworks/base/data/etc/preinstalled-packages-platform.xml
-->

<!-- TODO(b/406863453): these packages should be allow-listed in XML on their own project -->

<config>
   <!-- System apps -->
   <install-in-user-type package="com.google.android.desktop.identity.login">
      <install-in user-type="SYSTEM" />
   </install-in-user-type>
   <install-in-user-type package="com.android.desktop.sar">
