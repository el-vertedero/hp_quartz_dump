        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
    </install-in-user-type>

    <!-- Pixel play auto-install (PAI) stub app. Enables phonesky to install
      certain app prebuilts on device setup or when the first account is added to the user.
      Preventing stub app installation disables PAI for the user -->
    <install-in-user-type package="android.autoinstalls.config.google.nexus">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
    </install-in-user-type>

    <!-- Pixel play auto-install (PAI) stub app for desktop Android. Same
         requirements as android.autoinstalls.config.google.nexus. -->
    <install-in-user-type package="android.autoinstalls.config.google.desktop">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
    </install-in-user-type>

    <!-- BetterBug external app Android Beta Feedback is not used on desktop devices. Desktop
    devices instead uses com.google.android.apps.internal.betterbug and
    com.google.android.apps.betterbug.partners for BetterBug and Android Tester Feedback
    respectively. These apps are preinstalled through the config above. -->

