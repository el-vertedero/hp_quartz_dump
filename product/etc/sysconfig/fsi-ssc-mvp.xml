<!-- This configuration is meant to contain a list of packages that have their
     signatures checked on boot as part of Full Stack Integrity (FSI) MVP
     release. go/fsi-expansion-framework-->
<config>
    <!-- These packages should have their signatures verified at boot. -->
    <require-strict-signature package="com.google.android.apps.dynamite" />
    <require-strict-signature package="com.google.android.apps.messaging" />
    <require-strict-signature package="com.google.android.apps.work.clouddpc" />
    <require-strict-signature package="com.google.android.calendar" />
    <require-strict-signature package="com.google.android.contacts" />
    <require-strict-signature package="com.google.android.gm" />
</config>
