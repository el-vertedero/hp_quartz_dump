<permissions>
    <privapp-permissions package="com.google.android.desktop.feedback">
        <permission name="android.permission.DUMP"/>
        <permission name="android.permission.INITIATE_BUGREPORT_AS_NON_ADMIN"/>
        <permission name="android.permission.INTERACT_ACROSS_USERS"/>
        <permission name="android.permission.MANAGE_USERS"/>
        <permission name="android.permission.PACKAGE_USAGE_STATS"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        <permission name="android.permission.READ_DROPBOX_DATA"/>
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
        <permission name="android.permission.READ_LOGS"/>
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND"/>
        <permission name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND"/>
        <permission name="android.permission.LOCAL_MAC_ADDRESS"/>
        <permission name="android.permission.BLUETOOTH_PRIVILEGED"/>
        <permission name="android.permission.CAPTURE_CONSENTLESS_BUGREPORT_DELEGATED_CONSENT"/>
    </privapp-permissions>

    <privapp-permissions package="com.google.android.desktop.tips">
        <permission name="android.permission.READ_DEVICE_CONFIG"/>
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
        <permission name="android.permission.READ_SYSTEM_GRAMMATICAL_GENDER"/>
        <permission name="android.permission.POST_NOTIFICATIONS"/>
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
    </privapp-permissions>

    <privapp-permissions package="com.google.android.factory.repair">
        <permission name="android.permission.REBOOT" />
        <permission name="android.permission.SHUTDOWN" />
        <permission name="android.permission.FOREGROUND_SERVICE" />
    </privapp-permissions>

    <privapp-permissions package="com.google.android.factory.launcher">
        <permission name="android.permission.INSTALL_PACKAGES"/>
    </privapp-permissions>

    <privapp-permissions package="com.google.android.factory.diagnostics">
        <permission name="android.permission.LOCAL_MAC_ADDRESS" />
    </privapp-permissions>

    <privapp-permissions package="com.google.android.desktop.ioshub">
        <permission name="android.permission.BLUETOOTH_PRIVILEGED" />
        <permission name="android.permission.MODIFY_PHONE_STATE" />
    </privapp-permissions>

    <privapp-permissions package="com.google.android.desktop.alai">
        <permission name="android.permission.SUBSTITUTE_SHARE_TARGET_APP_NAME_AND_ICON"/>
        <permission name="android.permission.POST_NOTIFICATIONS"/>
    </privapp-permissions>

    <privapp-permissions package="com.google.android.inputmethod.latin">
        <permission name="android.permission.QUERY_USERS"/>
        <permission name="android.permission.INJECT_KEY_EVENTS"/>
        <permission name="android.permission.PERSONAL_CONTEXT_PUBLISH_HINTS"/>
        <permission name="android.permission.PERSONAL_CONTEXT_RECEIVE_INSIGHTS"/>
        <permission name="android.permission.PERSONAL_CONTEXT_HOST_INSIGHT_SURFACE"/>
    </privapp-permissions>

    <privapp-permissions package="com.google.android.desktop.gpointer.app">
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
    </privapp-permissions>

    <privapp-permissions package="com.google.android.tetheringentitlement">
        <!-- Required to bypass private DNS settings and use carrier's DNS instead. -->
        <permission name="android.permission.CONNECTIVITY_USE_RESTRICTED_NETWORKS"/>
        <!-- Required to get phone number, IMSI and ICCID. -->
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
        <!-- Required to change tether state, for Android 11 or later. -->
        <permission name="android.permission.TETHER_PRIVILEGED"/>
        <!-- Required to read the APN settings. -->
        <permission name="android.permission.WRITE_APN_SETTINGS"/>
    </privapp-permissions>

    <privapp-permissions package="com.google.android.apps.pixel.psi">
        <permission name="android.permission.INTERACT_ACROSS_USERS"/>
        <permission name="android.permission.SCHEDULE_EXACT_ALARM" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
        <permission name="android.permission.USE_ON_DEVICE_INTELLIGENCE" />
        <permission name="android.permission.PACKAGE_USAGE_STATS" />
        <!-- Permissions for personal context. -->
        <permission name="android.permission.PERSONAL_CONTEXT_PUBLISH_HINTS" />
        <permission name="android.permission.PERSONAL_CONTEXT_RECEIVE_HINTS" />
        <permission name="android.permission.PERSONAL_CONTEXT_PUBLISH_INSIGHTS" />
        <permission name="android.permission.PERSONAL_CONTEXT_RECEIVE_INSIGHTS" />
        <permission name="android.permission.PERSONAL_CONTEXT_READ_SETTINGS" />
        <permission name="android.permission.PERSONAL_CONTEXT_WRITE_SETTINGS" />
    </privapp-permissions>
</permissions>
