<?xml version="1.0" encoding="utf-8"?>
<config>
    <!--  Face enroll TrafficLight UI component (TrafficLightFaceOverlay) -->
    <install-in-user-type package="com.google.android.overlay.trafficlightfaceoverlay">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
        <install-in user-type="android.os.usertype.profile.PRIVATE" />
    </install-in-user-type>

    <!--  Face enroll Activity (SettingsGoogleFutureFaceEnroll) -->
    <install-in-user-type package="com.google.android.settings.future.biometrics.faceenroll">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
        <install-in user-type="android.os.usertype.profile.PRIVATE" />
    </install-in-user-type>
</config>
