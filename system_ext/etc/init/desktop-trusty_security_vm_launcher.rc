service trusty_security_vm_launcher /system_ext/bin/trusty_security_vm_launcher \
        --kernel /system_ext/etc/vm/trusty_vm/desktop_trusty_ext_boot_signed.elf \
        --memory-size-mib 200 \
        --cpu-topology match-host
    disabled
    user system
    group system virtualmachine
    capabilities IPC_LOCK NET_BIND_SERVICE SYS_RESOURCE SYS_NICE
    stdio_to_kmsg

service trusty_security_protected_vm_launcher /system_ext/bin/trusty_security_vm_launcher \
        --kernel ${desktop.security_vm.vm_image} \
        --rpc-services-config /system_ext/etc/vm/trusty_vm/desktop-security_vm_rpc_services.json \
        --vm-instance-id  /system_ext/etc/vm/trusty_vm/desktop_trusty_security_vm_instance_id \
        --memory-size-mib 200 \
        --cpu-topology match-host \
        --protected \
        --disable-secretkeeper
    disabled
    user system
    group system virtualmachine
    capabilities IPC_LOCK NET_BIND_SERVICE SYS_RESOURCE SYS_NICE
    stdio_to_kmsg
    interface aidl android.os.IAccessor/ICommService/security_vm_keymint
    interface aidl android.os.IAccessor/IKeyMintProvisioningService/security_vm_keymint
    interface aidl android.os.IAccessor/IFingerGuard/security_vm_fingerguard
    interface aidl android.os.IAccessor/IVmAttestation/default
    interface aidl android.os.IAccessor/IHatSeedProvisioning/security_vm_keymint


# Starts the non-secure Trusty VM in /system_ext when the feature is enabled through
# the system property set in vendor init.
on init && property:trusty.security_vm.enabled=1 && property:ro.boot.hypervisor.protected_vm.supported=1 && \
  property:ro.boot.boot_source=internal
    setprop trusty.security_vm.nonsecure_vm_ready 1
    setprop trusty.security_vm.vm_cid 200
    setprop trusty.security_vm.keymint.enabled 1
    setprop ro.hardware.trusty_ipc_dev.gatekeeper VSOCK:${trusty.security_vm.vm_cid}:0
    setprop storageproxyd_system.trusty_ipc_dev VSOCK:${trusty.security_vm.vm_cid}:0
    setprop desktop.security_vm.vm_image /system_ext/etc/vm/trusty_vm/desktop_trusty_signed.elf
    start trusty_security_protected_vm_launcher

on init && property:trusty.security_vm.enabled=1 && property:ro.boot.hypervisor.protected_vm.supported=1 && \
  property:ro.boot.boot_source=external
    setprop trusty.security_vm.nonsecure_vm_ready 1
    setprop trusty.security_vm.vm_cid 200
    setprop trusty.security_vm.keymint.enabled 1
    setprop ro.hardware.trusty_ipc_dev.gatekeeper VSOCK:${trusty.security_vm.vm_cid}:0
    setprop storageproxyd_system.trusty_ipc_dev VSOCK:${trusty.security_vm.vm_cid}:0
    setprop desktop.security_vm.vm_image /system_ext/etc/vm/trusty_vm/desktop_trusty_ext_boot_signed.elf
    start trusty_security_protected_vm_launcher


# Starts the non-secure Trusty VM in /system_ext when the feature is enabled through
# the system property set in vendor init.
on init && property:trusty.security_vm.enabled=1 && property:ro.boot.hypervisor.protected_vm.supported=""
    setprop trusty.security_vm.nonsecure_vm_ready 1
    setprop trusty.security_vm.vm_cid 200
    start trusty_security_vm_launcher

on init && property:trusty.security_vm.enabled=1 && property:ro.boot.hypervisor.protected_vm.supported=0
    setprop trusty.security_vm.nonsecure_vm_ready 1
    setprop trusty.security_vm.vm_cid 200
    start trusty_security_vm_launcher
