#
# Hori Fighting Stick Mini Controller - PS5 mode - USB
#

# Face Buttons
key 0x131  BUTTON_A  # Cross
key 0x132  BUTTON_B  # Circle
key 0x130  BUTTON_X  # Square
key 0x133  BUTTON_Y  # Triangle

# Trigger Buttons
key 0x134  BUTTON_L1    # L1
key 0x135  BUTTON_R1    # R1
key 0x136  BUTTON_L2    # L2
key 0x137  BUTTON_R2    # R2

# L3/R3 Buttons mapped to Thumbstick buttons
key 0x13a  BUTTON_THUMBL  # L3
key 0x13b  BUTTON_THUMBR  # R3

# Special Buttons
key 0x138  BUTTON_START   # Options button (3 vertical lines)
key 0x139  BUTTON_SELECT  # Select button
key 0x13c  BUTTON_MODE    # Mode button (PlayStation symbol)

# Joystick Axis
axis 0x10 HAT_X  # ABS_HAT0X (Joystick Left/Right)
axis 0x11 HAT_Y  # ABS_HAT0Y (Joystick Up/Down)
