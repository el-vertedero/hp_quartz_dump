<config>
    <!--  Documents UI (DocumentsUIGoogle) -->
    <install-in-user-type package="com.google.android.documentsui">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
        <install-in user-type="android.os.usertype.profile.PRIVATE" />
    </install-in-user-type>

    <!--  Google Print Recommendation Service (GooglePrintRecommendationService) -->
    <install-in-user-type package="com.google.android.printservice.recommendation">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.CLONE" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
        <install-in user-type="android.os.usertype.profile.PRIVATE" />
    </install-in-user-type>

    <!-- NFC (TagGoogle) -->
    <install-in-user-type package="com.google.android.tag">
        <install-in user-type="FULL" />
        <install-in user-type="PROFILE" />
    </install-in-user-type>

    <!-- Android User Avatar Picker (AvatarPickerGoogle) -->
    <!-- supporting Google Account profile picture syncing  -->
    <install-in-user-type package="com.google.android.avatarpicker">
        <install-in user-type="FULL"/>
    </install-in-user-type>

    <!--  Default package installer (GooglePackageInstaller) -->
    <install-in-user-type package="com.google.android.packageinstaller">
        <!-- Needed for desktop mode -->
        <install-in user-type="SYSTEM" />
        <install-in user-type="FULL" />
        <!-- Need to install for all profiles so users can install/uninstall apps there -->
        <install-in user-type="android.os.usertype.profile.MANAGED" />
        <install-in user-type="android.os.usertype.profile.PRIVATE" />
        <install-in user-type="android.os.usertype.profile.CLONE" />
    </install-in-user-type>
</config>
