on post-fs
    mkdir /metadata/gscutil 775 hsm hsm
    wait /dev/tpm0 10
    exec - hsm hsm -- /system/bin/gscutil --direct-gsc \
        perform-os-startup \
        --fw-zip-mp /system/etc/security/gsc.zip \
        --fw-zip-prepvt /system/etc/security/gsc.prepvt.zip \
        --metadata /metadata/gscutil/gsc_update \
        --use-memfd
