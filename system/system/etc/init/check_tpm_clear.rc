on early-fs
    mkdir /metadata/hwsec_metadata 775 root root

# Write to hwsec-ownership-id to /metadata/hwsec_metadata/hwsec-ownership-id
# when we have a successful mount
on post-fs-data
    exec_background -- /system/bin/check_tpm_clear
