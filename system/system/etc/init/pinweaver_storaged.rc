service android.system.desktop.security.pinweaver_storaged /system/bin/pinweaver_storaged \
        --db-path /metadata/pinweaver/pinweaver.sqlite3
    class early_hal
    user system
    group system
    disabled

on late-fs && property:trusty.security_vm.enabled=1 && property:ro.boot.hypervisor.protected_vm.supported=1
    mkdir /metadata/pinweaver 0700 system system
    start android.system.desktop.security.pinweaver_storaged
